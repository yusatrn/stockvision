# StockVision AI — Local Environment Example
# Copy to .env for local execution. Never commit real secrets or production credentials.

# PostgreSQL (Docker Compose)
POSTGRES_DB=stockvision
POSTGRES_USER=stockvision
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# Backend Spring Boot
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/stockvision
DB_USERNAME=stockvision
DB_PASSWORD=change_me_local_only

# CORS (comma-separated explicit origins; wildcards are forbidden)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# OpenAPI / Swagger UI (disabled by default outside local profile)
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Security / JWT (always provide at least 32 random bytes locally; never commit real secrets)
JWT_SECRET=replace_with_at_least_32_random_bytes_for_local_dev_only
JWT_ISSUER=stockvision-api
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_STRENGTH=12

# Auth Endpoint Rate Limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Market Data Provider (mock | yahoo; 'yahoo' uses delayed public BIST data without commercial redistribution rights)
MARKET_DATA_PROVIDER=mock
MARKET_DATA_STALE_THRESHOLD_HOURS=24
MARKET_DATA_DEFAULT_LOOKBACK_DAYS=90
MARKET_DATA_YAHOO_BASE_URL=https://query1.finance.yahoo.com
MARKET_DATA_YAHOO_SYMBOL_SUFFIX=.IS
MARKET_DATA_YAHOO_TIMEOUT_MS=10000
MARKET_DATA_YAHOO_QUOTE_CACHE_SECONDS=60

# Scoring Freshness Rules
SCORING_MAX_DATA_AGE_HOURS=120
SCORING_REJECT_STALE_DATA=true

# Alert Evaluation Scheduler
ALERTS_SCHEDULER_ENABLED=true
ALERTS_SCHEDULER_FIXED_DELAY_MS=60000
ALERTS_REJECT_STALE_DATA=true
ALERTS_DEFAULT_COOLDOWN_MINUTES=60

# Optional Free AI Explanations (free options only: template | ollama | gemini-free)
# Deterministic template fallback is always active; never commit real API keys.
AI_PROVIDER=template
AI_TIMEOUT_MS=15000
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_OLLAMA_MODEL=llama3.2:3b
AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_GEMINI_MODEL=gemini-2.0-flash-lite
AI_GEMINI_API_KEY=
